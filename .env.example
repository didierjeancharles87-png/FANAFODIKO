DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_NUM_PROXIES=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_NAME=fanafodiko_db
DATABASE_USER=fanafodiko_user
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Limites de débit (format DRF "nombre/période"). À ajuster par environnement.
THROTTLE_LOGIN_IP=20/m
THROTTLE_LOGIN_ACCOUNT=5/m
THROTTLE_REGISTER_IP=10/h
THROTTLE_REGISTER_ACCOUNT=3/h
THROTTLE_CSRF_IP=60/m
THROTTLE_COUPON_IP=30/m
THROTTLE_COUPON_ACCOUNT=10/m

# Production uniquement : HSTS et nombre de proxies de confiance.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
